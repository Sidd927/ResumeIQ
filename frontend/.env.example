# Backend origin. Leave EMPTY in local dev: the app then calls relative /api/...
# URLs and the Vite dev server proxies them to FastAPI (no CORS involved).
# Set it for production builds, e.g. VITE_API_URL=https://api.resumeiq.app
VITE_API_URL=

# Where the Vite dev proxy forwards /api (dev server only).
VITE_PROXY_TARGET=http://localhost:8000

# true → use in-browser mock data; no backend needed (demo fallback).
VITE_USE_MOCK=false
