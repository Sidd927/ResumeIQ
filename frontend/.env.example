# ── Local development (copy to .env) ───────────────────────────────────────
# Leave VITE_API_URL EMPTY: the app calls relative /api/... URLs and the Vite
# dev server proxies them to FastAPI, so CORS never comes into play locally.
VITE_API_URL=

# Where the Vite dev proxy forwards /api (dev server only).
VITE_PROXY_TARGET=http://localhost:8000

# true → in-browser mock data; no backend needed (demo fallback).
VITE_USE_MOCK=false

# ── Production (set these in the Vercel dashboard, not in a file) ──────────
# VITE_API_URL=https://resumeiq-api.onrender.com
# VITE_USE_MOCK=false
