# Backend configuration. Copy to backend/.env for local development:
#   cp .env.example .env
# Values below match docker-compose.yml, so they work out of the box locally.
# In production (Render) these are set in the dashboard / render.yaml — never commit real values.

# development | production (production refuses to start with an unsafe config)
ENVIRONMENT=development
# debug | info | warning | error (default: debug in development, info in production)
LOG_LEVEL=

# Database
DATABASE_URL=postgresql://resumeiq_user:resumeiq_pass@localhost:5432/resumeiq_db

# Auth — production requires a random value of 32+ chars: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: comma-separated list of allowed browser origins (add your deployed frontend URL).
# CORS_ORIGINS is accepted as an alias.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000
# Optional regex for extra origins, e.g. Vercel previews: ^https://resumeiq(-[a-z0-9-]+)?\.vercel\.app$
BACKEND_CORS_ORIGIN_REGEX=

# Optional: Claude API for AI feedback (Phase 5 stretch goal) — leave empty until then
ANTHROPIC_API_KEY=

# spaCy model
SPACY_MODEL=en_core_web_sm

# sentence-transformers model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Create tables on startup without Alembic (dev convenience).
AUTO_CREATE_TABLES=true
# Apply Alembic migrations at startup (default: on in production only).
RUN_MIGRATIONS=

# Load NLP models at boot instead of on the first request (on in the Docker image)
PRELOAD_MODELS=false

# Brute-force protection on /api/auth/login and /register (per IP, per minute)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=5
REGISTER_RATE_LIMIT_PER_MINUTE=3
