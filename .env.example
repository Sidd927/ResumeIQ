# Copy to backend/.env (the backend reads .env from its working directory).
# Values below match docker-compose.yml, so they work out of the box locally.

# Database
DATABASE_URL=postgresql://resumeiq_user:resumeiq_pass@localhost:5432/resumeiq_db

# Auth
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend: comma-separated list of allowed browser origins (add your deployed frontend URL)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000

# Optional: Claude API for AI feedback (stretch goal)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# spaCy model
SPACY_MODEL=en_core_web_sm

# sentence-transformers model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Create tables on startup (dev). Set false where Alembic manages the schema.
AUTO_CREATE_TABLES=true

# Load NLP models at boot instead of on the first request (recommended in prod)
PRELOAD_MODELS=false
